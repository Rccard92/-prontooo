{
  "name": "prontooo",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @prontooo/web dev",
    "build": "pnpm --filter @prontooo/web build",
    "start": "pnpm --filter @prontooo/web start",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @prontooo/db generate",
    "db:migrate": "pnpm --filter @prontooo/db migrate",
    "db:studio": "pnpm --filter @prontooo/db studio",
    "seed": "pnpm --filter @prontooo/db seed",
    "test": "pnpm --filter @prontooo/web test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@tailwindcss/oxide"
    ]
  }
}
