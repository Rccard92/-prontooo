{
  "name": "cassetta",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @cassetta/web dev",
    "build": "pnpm --filter @cassetta/web build",
    "start": "pnpm --filter @cassetta/web start",
    "lint": "pnpm --filter @cassetta/web lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @cassetta/db generate",
    "db:migrate": "pnpm --filter @cassetta/db migrate",
    "db:studio": "pnpm --filter @cassetta/db studio"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@tailwindcss/oxide"
    ]
  }
}
