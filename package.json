{
  "name": "prontooo",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -C apps/web dev",
    "build": "pnpm -C apps/web build",
    "start": "pnpm -C apps/web start",
    "test": "pnpm -C packages/db test && pnpm -C apps/web test",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm -C packages/db generate",
    "db:migrate": "pnpm -C packages/db migrate",
    "db:studio": "pnpm -C packages/db studio",
    "seed": "pnpm -C packages/db seed"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@tailwindcss/oxide"
    ]
  }
}
