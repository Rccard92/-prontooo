# Copia in .env e riempi. Niente segreti nel repo: in produzione stanno su Railway.

# Postgres. In locale puoi usare l'URL pubblico del Postgres Railway (DATABASE_PUBLIC_URL).
DATABASE_URL=postgresql://postgres:password@localhost:5432/cassetta

# Passphrase unica di accesso all'app (Fase 2 in avanti)
APP_PASSPHRASE=

# Anthropic, per normalizzazione ingredienti e lettura volantini (Fase 1 e 5)
ANTHROPIC_API_KEY=
