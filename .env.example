# Copia in .env e riempi. Niente segreti nel repo: in produzione stanno su Railway.

# Postgres. In locale puoi usare l'URL pubblico del Postgres Railway (DATABASE_PUBLIC_URL).
DATABASE_URL=postgresql://postgres:password@localhost:5432/prontooo

# Firma dei cookie di sessione. Senza, se ne genera una a ogni avvio e tocca
# rientrare dopo ogni deploy. Una qualsiasi va bene:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SEGRETO_SESSIONE=

# Serve a chi si iscrive dopo il primo: l'app sta su un indirizzo pubblico e
# senza questo chiunque lo indovini si crea un pannello qui dentro.
CODICE_INVITO=

# Anthropic: legge una volta la lista ingredienti di ogni ricetta del catalogo
# e la converte in una ricetta a posti, coi tuoi grammi. Senza, il catalogo
# resta sfogliabile e il piano usa solo il ricettario scritto a mano.
#   MODELLO_NORMALIZZA  cambia il modello (predefinito: claude-haiku-4-5)
#   RICETTE_PER_BLOCCO  quante per chiamata, massimo 50 (predefinito: 20)
#   BLOCCHI_PER_GIRO    quanti blocchi di fila finche' c'e' arretrato (5)
ANTHROPIC_API_KEY=

# Segreto condiviso fra worker e web per le rotte /api/interno
SEGRETO_INTERNO=
# Indirizzo del web sulla rete privata di Railway, visto dal worker
URL_WEB_INTERNO=http://web.railway.internal:3000

# Promemoria push. Le chiavi si generano una volta sola:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# La pubblica va scritta due volte: il server firma con VAPID_PUBLIC_KEY, il
# browser si iscrive con NEXT_PUBLIC_VAPID_PUBLIC_KEY, che deve esserci al
# momento della build. Senza queste chiavi i promemoria semplicemente non ci
# sono, e il resto dell'app funziona uguale.
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Il contatto che finisce nella firma VAPID: lo leggono i server di push
# (Google, Mozilla) se c'e' un problema di consegna.
VAPID_CONTATTO=mailto:

# I volantini li scarica il worker da solo. Conad pero' e' una cooperativa: il
# volantino cambia per cooperativa regionale e per negozio, e l'indirizzo
# giusto e' quello del TUO punto vendita - altrimenti i prezzi mostrati non
# sono quelli che paghi. Si prende dal sito Conad, pagina volantini del negozio.
VOLANTINO_CONAD_URL=
CONAD_PUNTO_VENDITA=
# Ogni quanti giorni riprovare un'insegna (un volantino dura una settimana).
VOLANTINI_GIORNI=5
